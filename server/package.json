{
  "name": "spendwise-server",
  "version": "1.0.0",
  "description": "Backend API for the Expense Tracker MERN app",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seedCategories.js",
    "test:analytics": "node tests/analyticsDashboardTests.js",
    "test:transactions": "node tests/transactionCategoryTests.js",
    "test:budgets": "node tests/budgetApiTests.js",
    "test:split": "node tests/splitApiTests.js",
    "test:auth": "node tests/authOtpGoogleTests.js",
    "test": "node tests/splitApiTests.js",
    "test:all": "node tests/analyticsDashboardTests.js && node tests/transactionCategoryTests.js && node tests/budgetApiTests.js && node tests/splitApiTests.js && node tests/authOtpGoogleTests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
